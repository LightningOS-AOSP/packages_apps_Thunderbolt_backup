<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.lightning.control.prefs.HubCardPreference
        android:key="hub_sb_island"
        android:title="@string/hub_island_title"
        android:summary="@string/hub_island_summary"
        android:fragment="com.lightning.control.screens.DynamicIslandScreen"
        app:hubIcon="@drawable/hub_ic_dynamic_island" />

    <com.lightning.control.prefs.HubCardPreference
        android:key="hub_sb_cutout"
        android:title="@string/hub_cutout_title"
        android:summary="@string/hub_cutout_summary"
        android:fragment="com.lightning.control.screens.CutoutProgressScreen"
        app:hubIcon="@drawable/hub_ic_cutout_progress" />
    <com.lightning.control.prefs.HubCardPreference
        android:key="hub_sb_clock_chip"
        android:title="@string/hub_clock_chip_title"
        android:summary="@string/hub_clock_chip_summary"
        android:fragment="com.lightning.control.screens.ClockChipScreen"
        app:hubIcon="@drawable/hub_ic_clock_chip" />

    <com.lightning.control.prefs.HubCardPreference
        android:key="hub_sb_logo"
        android:title="@string/hub_logo_title"
        android:summary="@string/hub_logo_summary"
        android:fragment="com.lightning.control.screens.StatusBarLogoScreen"
        app:hubIcon="@drawable/hub_ic_logo" />
</PreferenceScreen>
